{
  "redirects": [
    {
      "source": "/os",
      "destination": "/spaceos",
      "permanent": false
    },
    {
      "source": "/os/:path*",
      "destination": "/spaceos/:path*",
      "permanent": false
    },
    {
      "source": "/space-rising-v2",
      "destination": "/spaceos",
      "permanent": true
    },
    {
      "source": "/space-rising-v2/:path*",
      "destination": "/spaceos/:path*",
      "permanent": true
    },
    {
      "source": "/space-rising",
      "destination": "/spaceos",
      "permanent": true
    },
    {
      "source": "/space-rising/:path*",
      "destination": "/spaceos/:path*",
      "permanent": true
    },
    {
      "source": "/srw-v2",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/os-db.js": {
      "includeFiles": "data/os-snapshot/**"
    },
    "api/sourcing/tenants.js": {
      "includeFiles": "data/os-snapshot/**"
    }
  }
}
